# Unity generated
Unity/HellcatSandbox/[Ll]ibrary/
Unity/HellcatSandbox/[Tt]emp/
Unity/HellcatSandbox/[Oo]bj/
Unity/HellcatSandbox/[Ll]ogs/
Unity/HellcatSandbox/[Uu]ser[Ss]ettings/
Unity/HellcatSandbox/*.csproj
Unity/HellcatSandbox/*.sln
Unity/HellcatSandbox/.vs/
Unity/HellcatSandbox/.idea/
Unity/HellcatSandbox/.vscode/
Unity/_cache/
Unity/_tmp/

# Build outputs (large, reproducible from the project)
Builds/

# Third-party sources, caches, environments
_tools/
_cache/
tools/.venv/
__pycache__/
*.pyc

# Blender backups
*.blend1
*.blend2
*.blend@

# Logs (reproducible, large)
docs/**/logs/
*.log

# Third-party reference drawings (private modelling reference, not redistributed)
reference_extra/
# dense traces and plots of those drawings (regenerate with tools/ref/extract_*.py)
docs/p1/ref_features*.json
docs/p1/ref_features_*.png
docs/p1/ref_profiles.png
docs/p1/overlay_*/

# Validation node-position snapshots (tens of MB per run, regenerated by the suite)
docs/p3/validation/*_snap.csv
# P3b diagnostics (X9 ... X17 run only when listed; reproducible, tens of MB)
docs/p3b/validation/X*.csv
docs/p3b/tmp/

# Crash runs (P4+): per-frame captures, GBs, regenerated by tools/p4/crash_series.ps1 (the videos are in docs/video_assets)
sim/cache/S*/**/frames/
# P6: the slow-motion replay frames (tools/p6/run_scenarios.ps1), the tuning scratch runs (tools/p6/tune.py) and the
# sweep runs' recordings (tools/p6/sweep.py keeps their results)
sim/cache/S*/**/frames_slowmo/
sim/cache/tune/
sim/cache/sweep/**/*.hrec
sim/cache/sweep/**/*.csv
!sim/cache/sweep/**/*_pulse.csv
# their stills (copied to docs/video_assets by tools/p4/make_videos.py)
sim/cache/S*/**/*.png
# P4 diagnostics X16 / X24 and the T12 / X13 tuning runs: per-run CSVs (reproducible, tens of MB); the summaries
# (dynamics_results.json) are kept
docs/p4/x16/*.csv
docs/p4/x24*/*.csv
docs/p4/t12/*.csv
docs/p4b/x24*/*.csv
# P4b: the showcase capture's frames (regenerated by HellcatDrive.exe -scenario showcase; the MP4 and the sheet are kept)
docs/p4b/capture/frames/
# drive test smoke runs
docs/p4b/drive_smoke*/
# P6: downloaded reference reports (public NHTSA PDFs, 10 MB each; the extracted text and the URL are kept)
docs/p6/refs/**/*.pdf
# P7: the sandbox checks' frame sequences and stills (tools/p7/run_p7.ps1; the encoded video is in docs/video_assets/P7)
docs/p7/capture/frames/
docs/p7/s1_50/frames/
docs/p7/s1_50/frames_slowmo/
docs/p7/s1_50/*.png
docs/p7/_*.jpg
# local shortcut to the built game
/Hellcat Sandbox.lnk
